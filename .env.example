# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Render & Friendship Test Deployment Variables
# PUBLIC_BASE_URL: Base URL used for generating shareable responder links (e.g., https://your-app.onrender.com)
PUBLIC_BASE_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string on Render (e.g., postgresql://user:pass@host/dbname)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/friendship_test"

# SECRET_KEY / SESSION_SECRET: Cryptographic secrets for hashing and owner session tokens
SECRET_KEY="generate_a_secure_random_secret_here"
SESSION_SECRET="generate_a_secure_session_secret_here"

# ENVIRONMENT: 'development' or 'production'
ENVIRONMENT="development"

